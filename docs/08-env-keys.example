# ── Database (already provided by the platform) ────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=change-me-long-random-string
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Single admin account (used by `npx tsx src/db/seed.ts`)
ADMIN_EMAIL=admin@dresses.pk
ADMIN_PASSWORD=Dresses@Admin1

# ── Email delivery ─────────────────────────────────────────────────────────
# "live" = send real email (plug your provider in src/lib/mailer.ts)
# anything else = dev mode: OTP is surfaced on screen for testing
EMAIL_DELIVERY=dev

# ── Stripe (cards) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── JazzCash ───────────────────────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true

# ── OAuth ──────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── AI assistant ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
